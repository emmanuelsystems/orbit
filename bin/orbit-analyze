#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ORBIT_HOME="${ORBIT_HOME:-$HOME/.orbit}"
slug="${1:-}"
date="${2:-}"
[ -n "$slug" ] || { echo "usage: orbit analyze <mission-slug> [YYYY-MM-DD]" >&2; exit 2; }
mission="$ORBIT_HOME/missions/$slug"
[ -d "$mission" ] || { echo "error: unknown Mission: $slug" >&2; exit 1; }
if [ -z "$date" ]; then date="$(find "$mission/orbits" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | sort | tail -1 || true)"; fi
[ -n "$date" ] || { echo "error: no Orbit exists" >&2; exit 1; }
orbit="$mission/orbits/$date"
[ -f "$orbit/source-index.md" ] || { echo "error: missing source-index.md" >&2; exit 1; }
if ! grep -q 'PINNED_' "$orbit/source-index.md"; then echo 'error: no pinned Flight Recorder; run orbit ingest first' >&2; exit 1; fi
orders="$(find "$orbit/crew-orders" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
returns="$(find "$orbit/crew-returns" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
runtime="$(awk '
  /^execution:/ { in_execution=1; next }
  in_execution && /^[^[:space:]]/ { in_execution=0 }
  in_execution && /^[[:space:]]+mode:/ { sub(/^[[:space:]]+mode:[[:space:]]*/, ""); print; exit }
' "$mission/crew.yaml")"
[ -n "$runtime" ] || runtime=sequential
printf 'ORBIT // CREW ORCHESTRATION\nMission: %s\nOrbit: %s\nCrew Manifest: %s\nCrew Registry: %s\nRuntime: %s\nCrew Orders: %s (%s files)\nCrew Returns: %s (%s files)\nReconciliation: %s\nActive context: %s\n' "$slug" "$date" "$mission/crew.yaml" "$ROOT/crews/registry.yaml" "$runtime" "$orbit/crew-orders" "$orders" "$orbit/crew-returns" "$returns" "$orbit/reconciliation.md" "$ORBIT_HOME/active-orbit.md"
if [ "$orders" -eq 0 ]; then
  echo 'NO CREW ORDERS' >&2
  echo 'Analysis cannot begin because no approved Crew Orders exist for this Orbit.' >&2
  echo 'Run /orbit-plan first.' >&2
  echo 'Do not silently generate orders.' >&2
  exit 1
elif [ "$runtime" = firstmate ]; then
  active_orders=0
  while IFS= read -r order; do
    order_name=$(basename "$order")
    [ -f "$orbit/crew-returns/$order_name" ] && continue
    active_orders=$((active_orders + 1))
    if ! preflight=$("$ROOT/bin/orbit" runtime firstmate preflight "$slug" "$date" "$order_name" 2>&1); then
      reason=$(printf '%s\n' "$preflight" | awk '/^error:/ { sub(/^error: /, ""); print; exit }')
      [ -n "$reason" ] || reason='Firstmate preflight could not verify immutable order provenance'
      printf 'FLIGHT STATUS: HOLD — FIRSTMATE PROVENANCE BLOCKED\nOrder: %s\nReason: %s\n' "$order_name" "$reason"
      echo 'Analysis stopped. No sequential fallback, Crew Return, reconciliation, Mission Packet, or Gate Control mutation was started.'
      echo 'Sequential execution is available only when crew.yaml explicitly selects mode: sequential.'
      exit 1
    fi
  done < <(find "$orbit/crew-orders" -maxdepth 1 -type f -name '*.md' -print | sort)
  if [ "$active_orders" -eq 0 ]; then
    echo 'FLIGHT STATUS: NO ACTIVE FIRSTMATE ORDERS'
    echo 'All Crew Orders already have matching Crew Returns. Reconcile only through the configured ORBIT operator flow.'
  else
    echo 'FLIGHT STATUS: CREW ORDERS READY FOR FIRSTMATE'
    echo 'Each active order passed read-only eligibility and provenance preflight.'
    echo 'Next: use `orbit runtime firstmate prepare`, inspect the scout brief, then submit and collect each completed report.'
    echo 'After returns are captured, invoke $orbit-analyze for ORBIT-owned reconciliation and Gate Control.'
  fi
elif [ "$runtime" = sequential ]; then
  echo 'FLIGHT STATUS: CREW ORDERS READY FOR SEQUENTIAL FALLBACK'
  echo 'Next: invoke $orbit-analyze in your agent to execute bounded sequential passes and reconcile returns.'
else
  echo 'FLIGHT STATUS: CREW ORDERS READY FOR CONFIGURED RUNTIME'
  echo 'Next: use a compatible runtime adapter that preserves Crew Order and Crew Return semantics, then reconcile inside ORBIT.'
fi
