#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ORBIT_HOME="${ORBIT_HOME:-$HOME/.orbit}"
slug="${1:-}"
transcript="${2:-}"
date="${3:-$(date +%F)}"
[ -n "$slug" ] && [ -n "$transcript" ] || { echo "usage: orbit ingest <mission-slug> <transcript-path> [YYYY-MM-DD]" >&2; exit 2; }
mission="$ORBIT_HOME/missions/$slug"
[ -d "$mission" ] || { echo "error: unknown Mission: $slug" >&2; exit 1; }
[ -f "$transcript" ] || { echo "error: Flight Recorder not found: $transcript" >&2; exit 1; }
transcript="$(cd "$(dirname "$transcript")" && pwd)/$(basename "$transcript")"
orbit="$mission/orbits/$date"
"$ROOT/bin/orbit-launch" "$slug" "$date" >/dev/null
for f in flight-recorder-analysis.md decision-action-register.md dispatch-return.md candidate-mission-state.md mission-control-plan.md crew-findings.md gate-log.md; do [ -e "$orbit/$f" ] || cp "$ROOT/templates/$f" "$orbit/$f"; done
awk -v p="$transcript" '/^- Transcript:/ { print "- Transcript: " p; next } /^- Status: `UNSET`/ { print "- Status: `PINNED_LOCAL_FILE`"; next } { print }' "$orbit/source-index.md" > "$orbit/source-index.md.tmp"
mv "$orbit/source-index.md.tmp" "$orbit/source-index.md"
printf 'FLIGHT RECORDER RECEIVED\nMission: %s\nOrbit: %s\nFlight Recorder: %s\nNo transcript bytes were copied into ORBIT_HOME.\nFLIGHT STATUS: READY FOR MISSION CONTROL\nNext: invoke $orbit-analyze in your agent. Mission Control will triage, plan Crew work, reconcile findings, and apply Gate Control.\n' "$slug" "$date" "$transcript"
