#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ORBIT_HOME="${ORBIT_HOME:-$HOME/.orbit}"
slug="${1:-}"
date="${2:-$(date +%F)}"
[ -n "$slug" ] || { echo "usage: orbit launch <mission-slug> [YYYY-MM-DD]" >&2; exit 2; }
mission="$ORBIT_HOME/missions/$slug"
[ -d "$mission" ] || { echo "error: unknown Mission: $slug" >&2; exit 1; }
[ -f "$mission/state/current.md" ] || { echo "error: incomplete Mission: missing $mission/state/current.md" >&2; exit 1; }
[ -f "$mission/crew.yaml" ] || cp "$ROOT/templates/crew-manifest.yaml" "$mission/crew.yaml"
orbit="$mission/orbits/$date"
umask 077
mkdir -p "$orbit"
for f in source-index.md briefing.md mission-control-plan.md crew-findings.md gate-log.md; do [ -e "$orbit/$f" ] || cp "$ROOT/templates/$f" "$orbit/$f"; done
[ -e "$orbit/state-snapshot.md" ] || cp "$mission/state/current.md" "$orbit/state-snapshot.md"
for f in source-index.md mission-control-plan.md crew-findings.md gate-log.md; do
  sed -i "s/^- Mission:$/- Mission: $slug/" "$orbit/$f" 2>/dev/null || true
  sed -i "s/^- Orbit date:$/- Orbit date: $date/" "$orbit/$f" 2>/dev/null || true
done
printf 'ORBIT LAUNCHED\nMission: %s\nOrbit: %s\nOrbit folder: %s\nCrew Manifest: %s\nFLIGHT STATUS: PRE-BRIEF\nNext: invoke $orbit-launch in your agent to complete the Briefing and Mission Control triage.\n' "$slug" "$date" "$orbit" "$mission/crew.yaml"
